# AI Text Assistant Configuration
# ================================
# Copy this file to .env and fill in your API keys

# AI Provider Selection
# Options: openai, huggingface, ollama
AI_PROVIDER=openai

# AI Model (optional - uses defaults if not specified)
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Hugging Face: mistralai/Mistral-7B-Instruct-v0.2, meta-llama/Llama-2-7b-chat-hf
# Ollama: llama2, mistral, codellama
# AI_MODEL=

# API Keys
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get your Hugging Face key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Ollama Configuration (for local models)
# Only needed if using Ollama provider
OLLAMA_BASE_URL=http://localhost:11434

# Generation Parameters
# Temperature: 0.0 (focused) to 2.0 (creative)
TEMPERATURE=0.7

# Maximum tokens to generate
MAX_TOKENS=1000

# Chat History Settings
HISTORY_DIR=chat_history
AUTO_SAVE_HISTORY=true

# Web UI Settings
WEB_HOST=127.0.0.1
WEB_PORT=5000
DEBUG_MODE=false
